#!/usr/bin/env bash
#
# ============================================================================
# 開発者向け
# ============================================================================
#
# テストを流したときの画面を静かにするためのコマンド。
#
# 全部通ったときは結果を 1 行だけ返す。どこも直す必要が無いのに 169 行流れて
# 画面が埋まる、という状態をやめるためのもの。
# 失敗したときは、これまでどおり「どのテストが」「なぜ」コケたかと、
# その 1 本だけを流し直すコマンドを出す。読む必要がある情報は削っていない。
#
# 出力は成功・失敗にかかわらず毎回ファイルに丸ごと残る。画面から消えるだけで、
# 中身は失われない。パスは実行のたびに最後の行に出る。
#
#   bin/test                    # 全部流す
#   bin/test spec/models        # 一部だけ流す
#   bin/test --seed 1234        # rspec の引数はそのまま渡せる
#   VERBOSE=1 bin/test          # 素通し。bundle exec rspec を直接叩いたのと同じ
#
# このリポジトリはコンテナ内で動かす前提なので、普段はこう叩く。
#
#   docker exec aruaru-game-web-1 bin/test
#
# binding.pry / debugger を使いたいときは VERBOSE=1 を付ける。
# 付けずに流した場合、デバッガは止まらずに素通りする（画面が固まることはない）。
#
# ============================================================================
# AI コーディングエージェント（Claude Code など）向け
# ============================================================================
#
# このリポジトリでテストを流すときは bundle exec rspec ではなく bin/test を使う。
#
# 理由: エージェントが打ったコマンドの出力は、全文がそのまま会話履歴に入る。
# rspec が成功したときのログは進捗ドットと環境の警告が大半で、判断材料としての
# 価値がほぼ無い。それがテストの本数に比例して積み上がり、コンテキスト
# （トークン）を圧迫して、本来読むべきコードを読む余地を削る。
#
# bin/test は、判断に使える情報（成否・件数・失敗の詳細）を落とさずに、
# 判断に使えない部分だけを画面から外す。実測で 8,139 バイト → 103 バイト。
#
# 失敗の詳細を読み切れないときや、成功時のログを検分する必要があるときは、
# 最後の行に出るパスをそのまま読むこと（VERBOSE=1 でも流し直せるが、
# 素通しモードなので出力が丸ごと会話に入る。節約の意味は無くなる）。
#
# なお通常モードは stdin を切ってあるので、spec に binding.pry が残っていても
# 待ちに入らず素通りする。エージェントの実行が固まることはない。
#
# 着想: https://x.com/kenn/status/2093701458445439033
# ============================================================================

set -uo pipefail

cd "$(dirname "$0")/.." || exit 1

# ログのパスは絶対パスで持つ。呼び出し元のカレントディレクトリはこの cd の
# 影響を受けないので、相対パスのまま表示すると受け取った側が開けない。
LOG_DIR="$PWD/tmp/test-logs"
mkdir -p "$LOG_DIR"
# 秒までの時刻だけだと、同じ秒に 2 回走ったときに同じファイルを奪い合い、
# 片方がもう片方の結果を自分のものとして報告してしまう。PID で分ける。
LOG="$LOG_DIR/rspec-$(date +%Y%m%d-%H%M%S)-$$.log"

# VERBOSE=1 は素通しモード。rspec をそのまま実行して、出力も入力もこの端末に
# 直結させる。全文が流れるうえ、binding.pry / debugger も普通に使える。
# ログは書かない（画面に全部出ているものを二重に持つ意味が無いため）。
if [ "${VERBOSE:-}" = "1" ]; then
  exec bundle exec rspec "$@"
fi

# 通常モードでは stdin を切る。spec に binding.pry が残ったまま流れると、
# rspec は入力を待つのにプロンプトはログ側へ消えるので、端末から見ると
# 無言で固まったようにしか見えない。切っておけば待たずに素通りして終わる。
# 対話デバッグが要るときは上の VERBOSE=1 を使う。
bundle exec rspec "$@" > "$LOG" 2>&1 < /dev/null
status=$?

# 古いログは 10 本だけ残す（これが無いと tmp が延々太る）
ls -1t "$LOG_DIR"/rspec-*.log 2>/dev/null | tail -n +11 | xargs -I{} rm -f {}

total_lines=$(wc -l < "$LOG" | tr -d ' ')
# 「93 examples, 0 failures」の行。rspec の版で表記が揺れて拾えなくても、
# 成否の判定自体は終了コードで行うので致命傷にはならない。
summary=$(grep -E '^[0-9]+ examples?, [0-9]+ failures?' "$LOG" | tail -1)

if [ "$status" -eq 0 ]; then
  echo "OK  ${summary:-すべて成功}  （出力 ${total_lines} 行は $LOG に格納）"
  exit 0
fi

echo "NG  ${summary:-rspec が失敗}"
echo

if grep -q '^Failures:' "$LOG"; then
  # 失敗した example の詳細。読む値打ちがあるのはここなので削らない
  sed -n '/^Failures:/,/^Finished in/p' "$LOG"
  echo
  # その 1 本だけ流し直すためのコマンド
  sed -n '/^Failed examples:/,$p' "$LOG"
else
  # example が 1 本も走らなかった型（読み込みエラー、DB 未接続、gem 未インストールなど）。
  # このとき rspec は Failures: セクションを出さないので、別に拾う必要がある。
  echo "--- example が実行されていない。起動時のエラー ---"
  hits=$(grep -E 'An error occurred while loading|Failure/Error:|Error:' "$LOG" | head -20)
  if [ -n "$hits" ]; then
    echo "$hits"
  else
    # 上の拾い方に当たらないエラー（bundler の "Could not find ... in locally
    # installed gems" など）で無言になると、原因が一切分からなくなる。
    # 何も拾えなかったときは末尾をそのまま出す。
    tail -n 30 "$LOG"
  fi
fi

echo
echo "全文（${total_lines} 行）: $LOG"
exit "$status"
