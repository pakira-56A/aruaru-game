<div class="flex flex-col items-center">
  <div class="flex items-center mb-2">
    <div class="text-xl font-bold text-fuchsia-400 ml-2"><%= @heading %></div>
  </div>
  <div class="text-md text-cyan-500 pb-4"><%= @intro %></div>

  <% if @tags.any? %>
    <div class="flex flex-wrap justify-center gap-2 max-w-3xl">
      <%= render partial: "tags/pill", collection: @tags %>
    </div>
  <% else %>
    <div class="my-10">
      <%= render "shared/posts/empty_posts_text" %>
      <%= render "shared/posts/new_posts_button" %>
    </div>
  <% end %>
</div>
